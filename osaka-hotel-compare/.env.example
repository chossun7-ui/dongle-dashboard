# 오사카 숙소 비교 도구 — API 키 (전부 선택 사항, 없으면 수동 조사 데이터만 사용)
# cp .env.example .env 후 값 채우기

# 1순위: 라쿠텐 웹서비스 Application ID
# 발급: https://webservice.rakuten.co.jp/ (본인 라쿠텐 계정 필요)
RAKUTEN_APP_ID=

# 2순위: Amadeus Self-Service — https://developers.amadeus.com/ 에서 발급 (무료 티어 존재)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# 운영 데이터가 필요하면 true (기본은 test 환경 엔드포인트 사용 — 실제 가격과 다를 수 있음)
AMADEUS_USE_PRODUCTION=false

# 3순위: SerpAPI (Google Hotels) — https://serpapi.com/ (유료)
SERPAPI_KEY=

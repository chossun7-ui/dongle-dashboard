# Recipe Film Script 비교 대시보드 환경 변수 예시
# 운영 시 cp .env.example .env 후 값을 실제 값으로 교체.

# --- 보안 ---
# 관리자 초기 비번. 최초 부팅 시 admin 테이블이 비어 있으면 이 값으로 부트스트랩한다.
# 부팅 후엔 관리자 UI에서 변경하고, 본 변수는 지워도 무방.
ADMIN_PASSWORD=changeme-now

# FTP 설비 비번을 SQLite에 저장할 때 쓰는 Fernet 대칭키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 절대 외부에 노출하지 말 것. 키를 잃으면 저장된 FTP 비번을 복호화할 수 없다.
FERNET_KEY=

# 세션 쿠키 서명용 시크릿. 임의의 긴 문자열.
SESSION_SECRET=

# --- 서버 ---
# 백엔드 바인드 주소·포트
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 프론트엔드 nginx가 노출하는 외부 포트
FRONTEND_PORT=8080

# CORS 허용 오리진 (개발 시 http://localhost:5173 등). 콤마 구분.
CORS_ORIGINS=http://localhost:5173

# --- DB ---
SQLITE_PATH=/data/recipe.db

# --- 병렬화 (관리자 UI에서 런타임 조정도 가능) ---
SCAN_WORKERS_GLOBAL=8
SCAN_WORKERS_PER_EQUIPMENT=2
SCAN_TIMEOUT_SEC=30

# --- 기타 ---
# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
